{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEEPSEEK_API_KEY": "$DEEPSEEK_API_KEY",
        "EXPO_PUBLIC_DEEPSEEK_API_BASE": "https://api.deepseek.com",
        "EXPO_PUBLIC_SUPABASE_URL": "$SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "$SUPABASE_ANON_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "env": {
        "EXPO_PUBLIC_DEEPSEEK_API_KEY": "$DEEPSEEK_API_KEY",
        "EXPO_PUBLIC_DEEPSEEK_API_BASE": "https://api.deepseek.com",
        "EXPO_PUBLIC_SUPABASE_URL": "$SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "$SUPABASE_ANON_KEY"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m1-medium",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_DEEPSEEK_API_KEY": "$DEEPSEEK_API_KEY",
        "EXPO_PUBLIC_DEEPSEEK_API_BASE": "https://api.deepseek.com",
        "EXPO_PUBLIC_SUPABASE_URL": "$SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "$SUPABASE_ANON_KEY"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    }
  }
}
